{
  "id": "./",
  "name": "Notebook – StudyHub",
  "short_name": "Notebook",
  "description": "Appunti, ripasso attivo, flashcard, PDF e note cliniche per studiare medicina.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c1020",
  "theme_color": "#0c1020",
  "categories": ["education", "medical", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    { "name": "Ripasso", "short_name": "Ripasso", "description": "Le sezioni e le flashcard di oggi", "url": "./#/review", "icons": [{ "src": "shortcut-review.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Blocco note", "short_name": "Blocco note", "description": "Scrivi a mano", "url": "./#/pad", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Articoli", "short_name": "Articoli", "description": "La tua bibliografia", "url": "./#/papers", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Flashcard", "short_name": "Flashcard", "description": "Ripassa le flashcard", "url": "./#/cards", "icons": [{ "src": "shortcut-cards.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Importa", "short_name": "Importa", "description": "Importa testo o un PDF", "url": "./#/import", "icons": [{ "src": "shortcut-import.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Calendario", "short_name": "Calendario", "description": "Il calendario dei ripassi", "url": "./#/calendar", "icons": [{ "src": "shortcut-calendar.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["application/pdf", ".pdf"] }]
    }
  },
  "file_handlers": [
    { "action": "./?open=pdf", "accept": { "application/pdf": [".pdf"] } }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] }
}
