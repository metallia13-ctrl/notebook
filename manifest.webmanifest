{
  "id": "./",
  "name": "StudyHub Notebook",
  "short_name": "Notebook",
  "description": "Appunti di studio, PDF annotati, flashcard e active recall collegati a StudyHub.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "./index.html#/review",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "background_color": "#0c1020",
  "theme_color": "#0c1020",
  "categories": ["education", "productivity", "medical"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    {
      "name": "Ripasso di oggi",
      "short_name": "Ripasso",
      "url": "./index.html#/review",
      "icons": [{ "src": "shortcut-review.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Studia le flashcard",
      "short_name": "Flashcard",
      "url": "./index.html#/study/all",
      "icons": [{ "src": "shortcut-cards.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Importa testo o PDF",
      "short_name": "Importa",
      "url": "./index.html#/import",
      "icons": [{ "src": "shortcut-import.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Calendario",
      "short_name": "Calendario",
      "url": "./index.html#/calendar",
      "icons": [{ "src": "shortcut-calendar.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["application/pdf", ".pdf"] }
      ]
    }
  }
}
